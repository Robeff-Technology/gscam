<launch>
  <!-- This launchfile should bring up a node that broadcasts a ros image
       transport on /webcam/image_raw -->

  <arg name="DEVICE1" default="/dev/video100"/>
  <arg name="DEVICE2" default="/dev/video101"/>
  <arg name="DEVICE3" default="/dev/video102"/>
  <arg name="DEVICE4" default="/dev/video103"/>
  <!-- The GStreamer framerate needs to be an integral fraction -->
  <arg name="FPS" default="30/1"/>
  
  <node namespace="camera1" name="gscam_driver_v4l" pkg="gscam" exec="gscam_node" output="screen">
    <param name="camera_name" value="camera1"/>
    <param name="camera_info_url" value="package://gscam/config/camera1_info.yaml"/>
    <param name="gscam_config" value="v4l2src device=$(var DEVICE1) ! video/x-raw,framerate=$(var FPS) ! videoconvert"/>
    <param name="frame_id" value="/camera1/camera_link"/>
    <param name="sync_sink" value="true"/>
  </node>

  <node namespace="camera2" name="gscam_driver_v4l" pkg="gscam" exec="gscam_node" output="screen">
    <param name="camera_name" value="camera2"/>
    <param name="camera_info_url" value="package://gscam/config/camera2_info.yaml"/>
    <param name="gscam_config" value="v4l2src device=$(var DEVICE2) ! video/x-raw,framerate=$(var FPS) ! videoconvert"/>
    <param name="frame_id" value="/camera2/camera_link"/>
    <param name="sync_sink" value="true"/>
  </node>

  <node namespace="camera3" name="gscam_driver_v4l" pkg="gscam" exec="gscam_node" output="screen">
    <param name="camera_name" value="camera3"/>
    <param name="camera_info_url" value="package://gscam/config/camera3_info.yaml"/>
    <param name="gscam_config" value="v4l2src device=$(var DEVICE3) ! video/x-raw,framerate=$(var FPS) ! videoconvert"/>
    <param name="frame_id" value="/camera3/camera_link"/>
    <param name="sync_sink" value="true"/>
  </node>

  <node namespace="camera4" name="gscam_driver_v4l" pkg="gscam" exec="gscam_node" output="screen">
    <param name="camera_name" value="camera4"/>
    <param name="camera_info_url" value="package://gscam/config/camera4_info.yaml"/>
    <param name="gscam_config" value="v4l2src device=$(var DEVICE4) ! video/x-raw,framerate=$(var FPS) ! videoconvert"/>
    <param name="frame_id" value="/camera4/camera_link"/>
    <param name="sync_sink" value="true"/>
  </node>
</launch> 