<launch>
  <!-- This launchfile should bring up a node that broadcasts a ros image
       transport on /webcam/image_raw -->

  <arg name="DEVICE" default="/dev/video100"/>
  <!-- The GStreamer framerate needs to be an integral fraction -->
  <arg name="FPS" default="30/1"/>
  <arg name="PUBLISH_FRAME" default="false"/>

  <node namespace="v4l" name="gscam_driver_v4l" pkg="gscam" exec="gscam_node" output="screen">
    <param name="camera_name" value="default"/>
    <param name="camera_info_url" value="package://gscam/config/camera0_info.yaml"/>
    <param name="gscam_config" value="v4l2src device=$(var DEVICE) ! video/x-raw,framerate=$(var FPS) ! videoconvert"/>
    <param name="frame_id" value="/v4l_frame"/>
    <param name="sync_sink" value="true"/>
    <param name="camera_frame_rate" value="30"/>
    <!-- Frame time = T_pps + phase + n / fps (card in PPS frame-sync mode).
         arrival_phase is measured on this setup (see "measured arrival phase"
         in the log); frame_delay=2 is provisional until confirmed with a
         PPS-driven LED test. -->
    <param name="grid_snap" value="true"/>
    <param name="grid_snap_mode" value="pps"/>
    <param name="grid_snap_fps" value="30.0"/>
    <param name="grid_snap_pps_arrival_phase" value="0.01565"/>
    <param name="grid_snap_pps_frame_delay" value="2"/>
    <param name="grid_snap_pps_phase" value="0.0"/>
  </node>

  <node if="$(var PUBLISH_FRAME)" name="v4l_transform" pkg="tf2_ros" exec="static_transform_publisher" args="1 2 3 0 -3.141 0 /world /v4l_frame"/>
</launch>
