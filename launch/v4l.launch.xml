<launch>
  <!-- This launchfile should bring up a node that broadcasts a ros image
       transport on /camera_name/image_raw -->

  <arg name="camera_name" default="camera1"/>
  <arg name="device" default="/dev/video100"/>
  <!-- The GStreamer framerate needs to be an integral fraction -->
  <arg name="FPS" default="30/1"/>
  
  <node namespace="$(var camera_name)" name="gscam_driver_v4l" pkg="gscam" exec="gscam_node" output="screen">
    <param name="camera_name" value="$(var camera_name)"/>
    <param name="camera_info_url" value="package://gscam/config/$(var camera_name)_info.yaml"/>
    <param name="gscam_config" value="v4l2src device=$(var device) ! video/x-raw,framerate=$(var FPS) ! videoconvert"/>
    <param name="frame_id" value="/$(var camera_name)/camera_link"/>
    <param name="sync_sink" value="true"/>
  </node>
</launch> 